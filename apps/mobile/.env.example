# Copy to .env.local. Only EXPO_PUBLIC_* values are bundled into the app.

# Firebase web config: Firebase console > Project settings > Your apps > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Dev only, until Firebase Auth is wired up (S1): customer | store | charity
# Leave empty to start at sign-in. Demo accounts (OTP 123456): customer 0912 345 678,
# store 0901 234 567, charity 0933 333 333. See docs/MOCK_API.md.
EXPO_PUBLIC_DEV_ROLE=
